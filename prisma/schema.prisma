generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  email String @unique

  password String

  accounts Account[]
  videos Video[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id String @id @default(cuid())

  type AccountType
  connected Boolean @default(false)

  sessions BrowserSession[]
  videos Video[]

  secuid String? @unique

  username String?
  profilePath String?

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@map("accounts")
}

model BrowserSession {
  id          String @id @default(cuid())

  accountId String 
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  status      BrowserSessionStatus

  qrImagePath String?

  createdAt   DateTime @default(now())

  expiresAt   DateTime

  @@index([accountId])
  @@map("browser_sessions")
}

model Video {
  id String @id @default(cuid())

  description String

  file String

  status VideoStatus

  tiktokVideoUrl String?
  errorMessage String?

  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  scheduledAt DateTime?

  userId String
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("videos")
}

model Notification {
  id String @id @default(cuid())

  message String
  isRead Boolean? @default(false)

  userId String 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

enum AccountType {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum VideoStatus {
  PENDING
  UPLOADING
  FAILED
  SCHEDULED
  POSTED
}

enum BrowserSessionStatus {
  CREATING
  WAITING_QR
  WAITING_LOGIN
  CONNECTED
  FAILED
  EXPIRED
}