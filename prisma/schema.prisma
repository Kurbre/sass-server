generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  email String @unique

  password String

  accounts Account[]
  videos Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(cuid())

  type AccountType
  connected Boolean @default(false)

  sessions BrowserSession[]

  secuid String?

  username String?
  profilePath String?

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
}

model BrowserSession {
  id          String @id @default(cuid())

  accountId String 
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  status      BrowserSessionStatus

  qrImagePath String?

  createdAt   DateTime @default(now())

  expiresAt   DateTime

  @@index([accountId])
}

model Video {
  id String @id @default(cuid())

  description String

  file String

  status VideoStatus

  scheduledAt DateTime?

  userId String
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
}

enum AccountType {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum VideoStatus {
  PEDNING
  UPLOADING
  FAILED
  SCHEDULED
  POSTED
}

enum BrowserSessionStatus {
  CREATING
  WAITING_QR
  WAITING_LOGIN
  CONNECTED
  FAILED
  EXPIRED
}